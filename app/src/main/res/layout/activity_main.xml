<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="PHP 8.5 + MariaDB + OpenCart 4 прямо на телефоне"
            android:textColor="#888888" />

        <TextView
            android:id="@+id/php_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/db_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textIsSelectable="true" />

        <TextView
            android:id="@+id/lan_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textIsSelectable="true"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/start"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Запустить" />

            <Button
                android:id="@+id/stop"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Остановить" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/lan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Доступ из Wi-Fi сети (с других устройств)" />

        <Button
            android:id="@+id/auto_install"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚡ Автоустановка OpenCart" />

        <Button
            android:id="@+id/open_install"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Установщик OpenCart (вручную)" />

        <Button
            android:id="@+id/open_site"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Открыть магазин" />

        <Button
            android:id="@+id/open_admin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Открыть админку" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#14000000"
            android:padding="12dp"
            android:text="Для ручной установки:\nDB Driver: MySQLi\nHostname: 127.0.0.1 (не localhost!)\nUsername: root\nPassword: (пусто)\nDatabase: opencart\nPort: 3306\nPrefix: oc_"
            android:textIsSelectable="true" />

        <Button
            android:id="@+id/ai"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="🤖 ИИ-мастер (Claude)" />

        <Button
            android:id="@+id/terminal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Терминал" />

        <Button
            android:id="@+id/battery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Не убивать в фоне (батарея)" />

        <Button
            android:id="@+id/logs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Логи" />

        <Button
            android:id="@+id/remove_install"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Удалить папку install" />

        <Button
            android:id="@+id/reset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Сбросить всё" />
    </LinearLayout>
</ScrollView>
